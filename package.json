{
  "name": "browser-play-set",
  "version": "1.0.0",
  "private": true,
  "description": "Ubuntu minimal server: isolated headless Chromium, Web workspace and MCP",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "bps": "src/cli.js"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli.js",
    "browsers": "playwright install --no-shell chromium",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "check": "node scripts/check.js",
    "smoke": "node scripts/smoke.js",
    "start:web": "node src/server.js"
  },
  "keywords": [
    "playwright",
    "browser-automation",
    "multi-profile",
    "chromium",
    "mcp",
    "ubuntu"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@novnc/novnc": "1.7.0",
    "@playwright/mcp": "0.0.83",
    "basic-auth": "3.0.0",
    "express": "^4.19.2",
    "lucide": "0.468.0",
    "p-queue": "^8.1.1",
    "playwright": "1.64.0-alpha-1790635538000",
    "proper-lockfile": "4.1.2",
    "write-file-atomic": "6.0.0",
    "ws": "8.22.0",
    "zod": "^4.6.5"
  }
}
